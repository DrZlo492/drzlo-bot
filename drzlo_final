class AppLogger:
    def __init__(
        self,
        path="drzlo_core.log",
        max_bytes=2_000_000,
        backups=5,
    ):
        self._log = (
            logging.getLogger(
                "drzlo"
            )
        )
        self._log.setLevel(
            logging.INFO
        )
        if not self._log.handlers:
            fh = RotatingFileHandler(
                path,
                maxBytes=max_bytes,
                backupCount=backups,
                encoding="utf-8",
            )
            fmt = logging.Formatter(
                "%(asctime)s "
                "%(levelname)s "
                "%(message)s"
            )
            fh.setFormatter(fmt)
            self._log.addHandler(
                fh
            )

    def info(self, msg):
        self._log.info(msg)

    def warning(self, msg):
        self._log.warning(msg)

    def error(self, msg):
        self._log.error(msg)


class CryptoHelper:
    def __init__(self):
        try:
            import cryptography.fernet as cf
            self._fernet = cf.Fernet
            self.secure = True
        except ImportError:
            self._fernet = None
            self.secure = False

    def make_key(self):
        if not self.secure:
            return None
        return (
            self._fernet.generate_key()
        )

    def encrypt(self, key, text):
        if not self.secure:
            return text
        box = self._fernet(key)
        out = box.encrypt(
            text.encode("utf-8")
        )
        return out.decode("utf-8")

    def decrypt(self, key, token):
        if not self.secure:
            return token
        box = self._fernet(key)
        raw = box.decrypt(
            token.encode("utf-8")
        )
        return raw.decode("utf-8")


class SecurityCore:
    ITERATIONS = 600000

    def hash_password(
        self, password, salt=None
    ):
        if salt is None:
            salt = os.urandom(16)
        digest = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode(
                "utf-8"
            ),
            salt,
            self.ITERATIONS,
        )
        return salt, digest

    def verify_password(
        self, password, salt,
        expected,
    ):
        _, digest = (
            self.hash_password(
                password, salt
            )
        )
        return hmac.compare_digest(
            digest, expected
        )


class Database:
    """+ last_signal_for_symbol
    (кулдаун), + signal_stats
    (/stats)."""

    def __init__(
        self, path="drzlo.db"
    ):
        self._lock = (
            threading.RLock()
        )
        self._conn = sqlite3.connect(
            path,
            check_same_thread=False,
        )
        self._conn.execute(
            "PRAGMA "
            "journal_mode=WAL"
        )
        self._conn.execute(
            "PRAGMA "
            "busy_timeout=5000"
        )
        self._create_tables()

    def _create_tables(self):
        with self._lock:
            cur = self._conn
            cur.execute(
                "CREATE TABLE IF "
                "NOT EXISTS users "
                "(telegram_id "
                "INTEGER PRIMARY "
                "KEY, role TEXT, "
                "created_at TEXT, "
                "last_seen TEXT)"
            )
            cur.execute(
                "CREATE TABLE IF "
                "NOT EXISTS "
                "messages (id "
                "INTEGER PRIMARY "
                "KEY AUTOINCREMENT"
                ", telegram_id "
                "INTEGER, "
                "direction TEXT, "
                "text TEXT, "
                "ts TEXT)"
            )
            cur.execute(
                "CREATE TABLE IF "
                "NOT EXISTS signals"
                " (id INTEGER "
                "PRIMARY KEY "
                "AUTOINCREMENT, "
                "symbol TEXT, "
                "price REAL, "
                "rsi REAL, "
                "adx REAL, "
                "change_pct REAL, "
                "ts TEXT)"
            )
            cur.execute(
                "CREATE TABLE IF "
                "NOT EXISTS "
                "signal_history (id"
                " INTEGER PRIMARY"
                " KEY "
                "AUTOINCREMENT, "
                "symbol TEXT, "
                "signal_type TEXT,"
                " entry_price "
                "REAL, exit_price"
                " REAL, result "
                "TEXT, timestamp "
                "TEXT)"
            )
            self._conn.commit()

    def set_role(
        self, telegram_id, role
    ):
        now = self._now()
        with self._lock:
            self._conn.execute(
                "INSERT INTO users"
                " (telegram_id, "
                "role, created_at"
                ", last_seen) "
                "VALUES (?,?,?,?)"
                " ON CONFLICT"
                "(telegram_id) DO"
                " UPDATE SET "
                "role=excluded."
                "role, last_seen="
                "excluded."
                "last_seen",
                (
                    telegram_id,
                    role, now, now,
                ),
            )
            self._conn.commit()

    def log_message(
        self, telegram_id,
        direction, text,
    ):
        with self._lock:
            self._conn.execute(
                "INSERT INTO "
                "messages "
                "(telegram_id, "
                "direction, text,"
                " ts) VALUES "
                "(?,?,?,?)",
                (
                    telegram_id,
                    direction, text,
                    self._now(),
                ),
            )
            self._conn.commit()

    def log_signal(self, sig):
        with self._lock:
            self._conn.execute(
                "INSERT INTO "
                "signals (symbol,"
                " price, rsi, "
                "adx, change_pct,"
                " ts) VALUES "
                "(?,?,?,?,?,?)",
                (
                    sig["symbol"],
                    sig["price"],
                    sig["rsi"],
                    sig["adx"],
                    sig[
                        "change_pct"
                    ],
                    self._now(),
                ),
            )
            self._conn.commit()

    def last_signals(self, limit=10):
        with self._lock:
            cur = self._conn.execute(
                "SELECT symbol, "
                "price, rsi, adx,"
                " change_pct, ts "
                "FROM signals "
                "ORDER BY id DESC"
                " LIMIT ?",
                (limit,),
            )
            return cur.fetchall()

    def open_signal(
        self, symbol, signal_type,
        entry_price,
    ):
        with self._lock:
            cur = self._conn.execute(
                "INSERT INTO "
                "signal_history "
                "(symbol, "
                "signal_type, "
                "entry_price, "
                "result, "
                "timestamp) "
                "VALUES "
                "(?,?,?,?,?)",
                (
                    symbol,
                    signal_type,
                    entry_price,
                    "PENDING",
                    self._now(),
                ),
            )
            self._conn.commit()
            return cur.lastrowid

    def pending_signals(
        self, limit=50
    ):
        with self._lock:
            cur = self._conn.execute(
                "SELECT id, "
                "symbol, "
                "signal_type, "
                "entry_price FROM"
                " signal_history "
                "WHERE "
                "result='PENDING'"
                " ORDER BY id ASC"
                " LIMIT ?",
                (limit,),
            )
            return cur.fetchall()

    def close_signal(
        self, row_id, exit_price,
        result,
    ):
        with self._lock:
            self._conn.execute(
                "UPDATE "
                "signal_history "
                "SET exit_price=?"
                ", result=? WHERE"
                " id=?",
                (
                    exit_price,
                    result, row_id,
                ),
            )
            self._conn.commit()

    def recent_results(
        self, limit=10
    ):
        with self._lock:
            cur = self._conn.execute(
                "SELECT result "
                "FROM "
                "signal_history "
                "WHERE result != "
                "'PENDING' ORDER"
                " BY id DESC "
                "LIMIT ?",
                (limit,),
            )
            return [
                r[0] for r in
                cur.fetchall()
            ]

    def last_signal_for_symbol(
        self, symbol
    ):
        with self._lock:
            cur = self._conn.execute(
                "SELECT id, "
                "result, "
                "timestamp FROM "
                "signal_history "
                "WHERE symbol=? "
                "ORDER BY id DESC"
                " LIMIT 1",
                (symbol,),
            )
            return cur.fetchone()

    def signal_stats(self):
        with self._lock:
            cur = self._conn.execute(
                "SELECT result, "
                "COUNT(*) FROM "
                "signal_history "
                "GROUP BY result"
            )
            counts = dict(
                cur.fetchall()
            )
        wins = counts.get("WIN", 0)
        losses = counts.get(
            "LOSS", 0
        )
        pending = counts.get(
            "PENDING", 0
        )
        return {
            "total": (
                wins + losses
                + pending
            ),
            "wins": wins,
            "losses": losses,
            "pending": pending,
        }

    def close(self):
        with self._lock:
            self._conn.close()

    @staticmethod
    def _now():
        return time.strftime(
            "%Y-%m-%d %H:%M:%S"
        )


class ConfigManager:
    SECRET_FIELDS = (
        "bot_token", "ai_api_key",
    )

    ENV_MAP = {
        "bot_token": (
            "DRZLO_BOT_TOKEN"
        ),
        "ai_api_key": (
            "DRZLO_AI_API_KEY"
        ),
        "ai_model": (
            "DRZLO_AI_MODEL"
        ),
        "owner_id": (
            "DRZLO_OWNER_ID"
        ),
    }

    TEMPLATE = {
        "bot_token": (
            "PUT_TELEGRAM_TOKEN"
        ),
        "owner_id": 0,
        "password_hash": "",
        "password_salt": "",
        "rsi_overbought": 70,
        "adx_trend": 25,
        "adx_threshold": 25,
        "price_change_pct": 2.0,
        "scan_interval_sec": 300,
        "ai_api_key": (
            "PUT_AI_API_KEY"
        ),
        "ai_model": (
            "llama-3.1-8b-instant"
        ),
        "win_rate": 0.0,
        "telegram_proxy": "",
    }

    def __init__(
        self,
        path="config.json",
        key_path="secret.key",
    ):
        self._path = os.path.join(
            os.getcwd(), path
        )
        self._lock = (
            threading.RLock()
        )
        self._crypto = CryptoHelper()
        self._key = self._load_key(
            os.path.join(
                os.getcwd(), key_path
            )
        )
        if not os.path.exists(
            self._path
        ):
            self._write_plain(
                dict(self.TEMPLATE)
            )
        self._data = self._read()
        self._data = (
            self._apply_env(
                self._data
            )
        )

    def _load_key(self, key_path):
        if not self._crypto.secure:
            return None
        if os.path.exists(key_path):
            with open(
                key_path, "rb"
            ) as fh:
                return fh.read()
        key = self._crypto.make_key()
        with open(
            key_path, "wb"
        ) as fh:
            fh.write(key)
        return key

    def _write_plain(self, data):
        tmp = self._path + ".tmp"
        with open(
            tmp, "w",
            encoding="utf-8",
        ) as fh:
            json.dump(
                data, fh,
                ensure_ascii=False,
                indent=2,
            )
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, self._path)

    def _read(self):
        try:
            with open(
                self._path, "r",
                encoding="utf-8",
            ) as fh:
                raw = json.load(fh)
        except (
            json.JSONDecodeError,
            OSError,
        ):
            bad = (
                self._path
                + ".corrupt"
            )
            try:
                os.replace(
                    self._path, bad
                )
            except OSError:
                pass
            raw = dict(self.TEMPLATE)
            self._write_plain(raw)
        cr = self._crypto
        for field in (
            self.SECRET_FIELDS
        ):
            val = raw.get(field, "")
            if val and not (
                val.startswith(
                    "PUT_"
                )
            ):
                try:
                    raw[field] = (
                        cr.decrypt(
                            self._key,
                            val,
                        )
                    )
                except Exception:
                    pass
        return raw

    def _apply_env(self, data):
        for key, env_name in (
            self.ENV_MAP.items()
        ):
            val = os.environ.get(
                env_name
            )
            if val is None:
                continue
            if key == "owner_id":
                try:
                    val = int(val)
                except ValueError:
                    continue
            data[key] = val
        return data

    def _write(self, data):
        enc = dict(data)
        cr = self._crypto
        for field in (
            self.SECRET_FIELDS
        ):
            val = enc.get(field, "")
            if val and not (
                val.startswith(
                    "PUT_"
                )
            ):
                enc[field] = (
                    cr.encrypt(
                        self._key,
                        val,
                    )
                )
        self._write_plain(enc)

    def get(self, key, default=None):
        with self._lock:
            return self._data.get(
                key, default
            )

    def set(self, key, value):
        with self._lock:
            self._data[key] = value
            self._write(self._data)


class TechnicalIndicators:
    @staticmethod
    def safe_float(value, default=0.0):
        try:
            out = float(value)
        except (TypeError, ValueError):
            return default
        if math.isnan(out) or math.isinf(out):
            return default
        return out

    @staticmethod
    def rsi(closes, period=14):
        if len(closes) <= period:
            return 50.0
        gains, losses = [], []
        for i in range(1, period + 1):
            delta = closes[i] - closes[i - 1]
            gains.append(max(delta, 0.0))
            losses.append(max(-delta, 0.0))
        avg_gain = sum(gains) / period
        avg_loss = sum(losses) / period
        for i in range(period + 1, len(closes)):
            delta = closes[i] - closes[i - 1]
            gain = max(delta, 0.0)
            loss = max(-delta, 0.0)
            avg_gain = (avg_gain * (period - 1) + gain) / period
            avg_loss = (avg_loss * (period - 1) + loss) / period
        if avg_gain == 0 and avg_loss == 0:
            return 50.0
        if avg_loss == 0:
            return 100.0
        rs = avg_gain / avg_loss
        return 100.0 - (100.0 / (1.0 + rs))

    @staticmethod
    def adx(highs, lows, closes, period=14):
        n = len(closes)
        if n <= period + 1:
            return 0.0
        plus_dm, minus_dm, tr_list = [0.0], [0.0], [0.0]
        for i in range(1, n):
            up = highs[i] - highs[i - 1]
            down = lows[i - 1] - lows[i]
            pdm = up if (up > down and up > 0) else 0.0
            mdm = down if (down > up and down > 0) else 0.0
            plus_dm.append(pdm)
            minus_dm.append(mdm)
            tr = max(
                highs[i] - lows[i],
                abs(highs[i] - closes[i - 1]),
                abs(lows[i] - closes[i - 1])
            )
            tr_list.append(tr)
        sm_tr = sum(tr_list[1:period + 1])
        sm_pdm = sum(plus_dm[1:period + 1])
        sm_mdm = sum(minus_dm[1:period + 1])

        def _dx(s_tr, s_pdm, s_mdm):
            if s_tr == 0: return 0.0
            pdi = 100.0 * s_pdm / s_tr
            mdi = 100.0 * s_mdm / s_tr
            denom = pdi + mdi
            if denom == 0: return 0.0
            return 100.0 * abs(pdi - mdi) / denom

        dx_values = [_dx(sm_tr, sm_pdm, sm_mdm)]
        for i in range(period + 1, n):
            sm_tr = sm_tr - sm_tr / period + tr_list[i]
            sm_pdm = sm_pdm - sm_pdm / period + plus_dm[i]
            sm_mdm = sm_mdm - sm_mdm / period + minus_dm[i]
            dx_values.append(_dx(sm_tr, sm_pdm, sm_mdm))
        if len(dx_values) < period:
            return sum(dx_values) / len(dx_values)
        adx_val = sum(dx_values[:period]) / period
        for i in range(period, len(dx_values)):
            adx_val = (adx_val * (period - 1) + dx_values[i]) / period
        return adx_val


class BinanceFuturesClient:
    BASE = "https://fapi.binance.com"
    DELAY = 0.25

    def _get(self, path, params=None):
        qs = "?" + uparse.urlencode(params) if params else ""
        url = self.BASE + path + qs
        req = ureq.Request(url, headers={"User-Agent": "drzlo/9.0"})
        with ureq.urlopen(req, timeout=10) as resp:
            raw = resp.read()
        time.sleep(self.DELAY)
        return json.loads(raw)

    def top_symbols(self, n=20):
        data = self._get("/fapi/v1/ticker/24hr")
        ti = TechnicalIndicators
        usdt = [d for d in data if str(d.get("symbol", "")).endswith("USDT")]
        usdt.sort(key=lambda d: ti.safe_float(d.get("quoteVolume")), reverse=True)
        return [d["symbol"] for d in usdt[:n]]

    def klines(self, symbol, interval="15m", limit=100):
        data = self._get("/fapi/v1/klines", {"symbol": symbol, "interval": interval, "limit": limit})
        ti = TechnicalIndicators
        return (
            [ti.safe_float(row[2]) for row in data],
            [ti.safe_float(row[3]) for row in data],
            [ti.safe_float(row[4]) for row in data]
        )

    def last_price(self, symbol):
        data = self._get("/fapi/v1/ticker/price", {"symbol": symbol})
        return TechnicalIndicators.safe_float(data.get("price"))

    def get_24h_change(self, symbol):
        data = self._get("/fapi/v1/ticker/24hr", {"symbol": symbol})
        if isinstance(data, list) and data:
            return TechnicalIndicators.safe_float(data[0].get("priceChangePercent"))
        return 0.0

    def get_1h_candles(self, symbol):
        return self.klines(symbol, interval="1h", limit=50)


class CryptoRadar:
    def __init__(self, config, db, logger, client=None, on_signal=None):
        self._cfg = config
        self._db = db
        self._log = logger
        self._client = client or BinanceFuturesClient()
        self._on_signal = on_signal
        self._alerted = {}

    def scan_once(self):
        triggered = []
        try:
            symbols = self._client.top_symbols(20)
        except Exception as exc:
            self._log.error("radar top_symbols: " + str(exc))
            return triggered
        
        for symbol in symbols:
            try:
                sig = self._check_symbol(symbol)
                if sig is not None:
                    triggered.append(sig)
                    self._db.log_signal(sig)
                    self._db.open_signal(sig["symbol"], sig["signal_type"], sig["price"])
                    if self._on_signal:
                        self._on_signal(sig)
            except Exception as exc:
                self._log.warning("radar symbol " + symbol + ": " + str(exc))
        return triggered

    def _check_symbol(self, symbol):
        highs, lows, closes = self._client.klines(symbol)
        if len(closes) < 30:
            return None
            
        rsi_th = self._cfg.get("rsi_overbought", 70)
        adx_th = self._cfg.get("adx_threshold", 25)
        chg_th = self._cfg.get("price_change_pct", 2.0)
        
        rsi_val = TechnicalIndicators.rsi(closes)
        adx_val = TechnicalIndicators.adx(highs, lows, closes)
        change = ((closes[-1] - closes[0]) / closes[0] * 100.0 if closes[0] else 0.0)

        is_pump = change > chg_th and rsi_val > rsi_th and adx_val > adx_th
        is_dump = change < -chg_th and rsi_val < (100 - rsi_th) and adx_val > adx_th

        if not (is_pump or is_dump):
            return None
            
        sig_type = "LONG" if is_pump else "SHORT"

        # MTF FILTER
        try:
            _, _, h1_closes = self._client.get_1h_candles(symbol)
            h1_rsi = TechnicalIndicators.rsi(h1_closes)
            if sig_type == "LONG" and h1_rsi < 50:
                return None
            if sig_type == "SHORT" and h1_rsi > 50:
                return None
        except Exception:
            pass

        # VOLUME FILTER
        try:
            v_data = self._client._get("/fapi/v1/klines", {"symbol": symbol, "interval": "5m", "limit": 12})
            vols = [TechnicalIndicators.safe_float(row[5]) for row in v_data]
            avg_vol = sum(vols[:-1]) / (len(vols) - 1)
            if avg_vol > 0 and vols[-1] < (avg_vol * 1.5):
                return None
        except Exception:
            pass

        return {
            "symbol": symbol,
            "price": closes[-1],
            "rsi": rsi_val,
            "adx": adx_val,
            "change_pct": change,
            "signal_type": sig_type,
        }

    def global_alert_loop(self, stop_event):
        while not stop_event.is_set():
            try:
                symbols = self._client.top_symbols(20)
                for symbol in symbols:
                    chg = self._client.get_24h_change(symbol)
                    if abs(chg) > 5.0:
                        now = time.time()
                        last_alert = self._alerted.get(symbol, 0)
                        if now - last_alert > 7200:
                            self._alerted[symbol] = now
                            if self._on_signal:
                                self._on_signal({"symbol": symbol, "signal_type": "24H_ALERT", "change_pct": chg})
            except Exception:
                pass
            stop_event.wait(300)

    def loop_forever(self, stop_event):
        interval = self._cfg.get("scan_interval_sec", 300)
        while not stop_event.is_set():
            self.scan_once()
            stop_event.wait(interval)


class AICore:
    GROQ_URL = "https://api.groq.com/openai/v1/chat/completions"
    SYSTEM = "Ты лаконичный ассистент-хакер."

    def __init__(self, config, logger):
        self._cfg = config
        self._log = logger

    def ask(self, text):
        key = self._cfg.get("ai_api_key", "")
        if not key or key.startswith("PUT_"):
            return "AI не настроен."
        model = self._cfg.get("ai_model", "llama-3.1-8b-instant")
        payload = {
            "model": model,
            "messages": [
                {"role": "system", "content": self.SYSTEM},
                {"role": "user", "content": text[:1000]}
            ],
            "max_tokens": 300,
            "temperature": 0.6,
        }
        body = json.dumps(payload).encode("utf-8")
        req = ureq.Request(self.GROQ_URL, data=body, method="POST", headers={
            "Authorization": "Bearer " + key, "Content-Type": "application/json"
        })
        try:
            with ureq.urlopen(req, timeout=20) as resp:
                data = json.loads(resp.read())
            return data["choices"][0]["message"]["content"]
        except Exception as e:
            return "Ошибка ИИ: " + str(e)


class SignalTracker(threading.Thread):
    CHECK_SEC = 900
    TARGET_PCT = 1.5
    WINDOW = 10
    MIN_WIN_RATE = 0.4
    MAX_THRESHOLD = 60

    def __init__(self, config, db, logger, client, stop_event):
        super().__init__(daemon=True)
        self._cfg = config
        self._db = db
        self._log = logger
        self._client = client
        self._stop_event = stop_event

    def run(self):
        while not self._stop_event.is_set():
            try:
                self._check_pending()
                self._adapt_threshold()
            except Exception as exc:
                self._log.error("tracker: " + str(exc))
            self._stop_event.wait(self.CHECK_SEC)

    def _check_pending(self):
        for row in self._db.pending_signals():
            row_id, symbol, sig_type, entry_price = row
            if not entry_price: continue
            price = self._client.last_price(symbol)
            change = (price - entry_price) / entry_price * 100.0
            if sig_type == "SHORT":
                change = -change
            if change >= self.TARGET_PCT:
                self._db.close_signal(row_id, price, "WIN")
            elif change <= -self.TARGET_PCT:
                self._db.close_signal(row_id, price, "LOSS")

    def _adapt_threshold(self):
        recent = self._db.recent_results(self.WINDOW)
        if len(recent) < self.WINDOW: return
        rate = recent.count("WIN") / len(recent)
        self._cfg.set("win_rate", rate)
        if rate < self.MIN_WIN_RATE:
            cur = self._cfg.get("adx_threshold", 25)
            new_val = min(cur + 5, self.MAX_THRESHOLD)
            if new_val != cur:
                self._cfg.set("adx_threshold", new_val)
                self._log.info(f"WinRate < 40%, ADX -> {new_val}")


class TelegramAdapter(threading.Thread):
    def __init__(self, config, db, sec, logger, radar, stop_event, ai_core=None):
        super().__init__(daemon=True)
        self._cfg = config
        self._db = db
        self._sec = sec
        self._log = logger
        self._radar = radar
        self._stop_event = stop_event
        self._ai = ai_core
        self._offset = 0
        self._start_time = time.time()

    def run(self):
        token = self._cfg.get("bot_token", "").strip()
        if not token or "PUT_" in token:
            self._log.warning("Telegram токен не задан.")
            return
        base = "https://api.telegram.org/bot" + token
        proxy = self._cfg.get("telegram_proxy", "")
        
        if proxy and proxy.startswith("socks"):
            self._log.warning("SOCKS прокси не поддерживается urllib. Игнорируем.")
            proxy = ""

        opener = ureq.build_opener(ureq.ProxyHandler({"http": proxy, "https": proxy})) if proxy else ureq.build_opener()

        while not self._stop_event.is_set():
            try:
                url = base + "/getUpdates?" + uparse.urlencode({"timeout": 20, "offset": self._offset})
                with opener.open(url, timeout=25) as resp:
                    data = json.loads(resp.read())
                for upd in data.get("result", []):
                    self._offset = upd["update_id"] + 1
                    self._process_update(base, upd, opener)
            except Exception as exc:
                self._stop_event.wait(3)

    def _process_update(self, base, upd, opener):
        msg = upd.get("message")
        if not msg: return
        chat_id = msg.get("chat", {}).get("id")
        text = msg.get("text", "")
        user_id = msg.get("from", {}).get("id")
        chat_type = msg.get("chat", {}).get("type")
        
        if not chat_id or not user_id: return
        
        self._db.log_message(chat_id, "in", text)
        reply = self._dispatch(chat_id, user_id, chat_type, text)
        
        if reply:
            # HUMAN EMULATION
            try:
                opener.open(base + "/sendChatAction", uparse.urlencode({"chat_id": chat_id, "action": "typing"}).encode())
            except Exception:
                pass
            time.sleep(random.uniform(1.5, 4.0))
            self._send(base, chat_id, reply, opener)

    def _dispatch(self, chat_id, user_id, chat_type, text):
        text = text[:2000]
        cmd = text.strip().split(" ")[0].lower()
        owner_id = self._cfg.get("owner_id", 0)

        if cmd == "/start":
            return "DRZLO v9.0 ONLINE"
        if cmd == "/login":
            if user_id == owner_id: return "Ты уже OWNER."
            # (тут можно добавить проверку пароля, если нужно)
            self._cfg.set("owner_id", user_id)
            return "Доступ разрешен (Новый OWNER)."
            
        if user_id != owner_id:
            return "Доступ запрещен."

        if cmd == "/status":
            rate = self._cfg.get("win_rate", 0.0)
            adx_th = self._cfg.get("adx_threshold", 25)
            return f"Система активна.\nWin Rate: {rate:.0%}\nADX: {adx_th}"
            
        if cmd == "/stats":
            stats = self._db.signal_stats()
            return f"Total: {stats['total']}\nWins: {stats['wins']}\nLosses: {stats['losses']}\nPending: {stats['pending']}"
            
        if cmd == "/scan":
            res = self._radar.scan_once()
            if not res: return "Сигналов нет."
            return "\n".join(f"{s['symbol']} {s['signal_type']} {s['change_pct']:.2f}%" for s in res)
            
        if self._ai and not cmd.startswith("/"):
            return self._ai.ask(text)

        return "Команды: /status, /stats, /scan"

    def _send(self, base, chat_id, text, opener):
        try:
            body = uparse.urlencode({"chat_id": chat_id, "text": text[:4000]}).encode("utf-8")
            opener.open(ureq.Request(base + "/sendMessage", data=body), timeout=10).read()
        except Exception:
            pass


class DrzloApp:
    def __init__(self):
        self.ui = ConsoleUI()
        self.logger = AppLogger()
        self.config = ConfigManager()
        self.db = Database()
        self.security = SecurityCore()
        self.stop_event = threading.Event()
        self.binance = BinanceFuturesClient()
        self.radar = CryptoRadar(self.config, self.db, self.logger, client=self.binance, on_signal=self._on_signal)
        self.ai = AICore(self.config, self.logger)
        self.telegram = TelegramAdapter(self.config, self.db, self.security, self.logger, self.radar, self.stop_event, ai_core=self.ai)
        self.tracker = SignalTracker(self.config, self.db, self.logger, self.binance, self.stop_event)
        
        try:
            signal.signal(signal.SIGINT, self._on_sig)
            signal.signal(signal.SIGTERM, self._on_sig)
        except Exception:
            pass

    def _on_sig(self, signum, frame):
        self.stop_event.set()

    def _on_signal(self, sig):
        text = f"🚨 {sig['symbol']} {sig['signal_type']} {sig['change_pct']:.2f}%"
        self.logger.info(text)
        # отправка в телегу без ожидания (чтобы не блокировать радар)
        threading.Thread(target=self._send_signal_tg, args=(text,), daemon=True).start()

    def _send_signal_tg(self, text):
        token = self.config.get("bot_token", "")
        owner = self.config.get("owner_id", 0)
        if not token or not owner: return
        try:
            url = f"https://api.telegram.org/bot{token}/sendMessage"
            body = uparse.urlencode({"chat_id": owner, "text": text}).encode()
            ureq.urlopen(ureq.Request(url, data=body), timeout=5).read()
        except Exception:
            pass

    def run(self):
        self.ui.banner()
        self.telegram.start()
        self.tracker.start()
        threading.Thread(target=self.radar.loop_forever, args=(self.stop_event,), daemon=True).start()
        threading.Thread(target=self.radar.global_alert_loop, args=(self.stop_event,), daemon=True).start()
        
        self.ui.green("Система запущена. Ctrl+C для выхода.")
        try:
            while not self.stop_event.is_set():
                time.sleep(1)
        except KeyboardInterrupt:
            self.stop_event.set()
        
        self.ui.yellow("Остановка...")
        self.db.close()
        self.ui.red("Завершено.")


if __name__ == "__main__":
    app = DrzloApp()
    app.run()